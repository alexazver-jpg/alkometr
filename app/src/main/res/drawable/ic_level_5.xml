<?xml version="1.0" encoding="utf-8"?>
<!-- Степень 5: бокал-призрак. Глаза-крестики, рот зигзагом, зеленоватый оттенок, ореол. Акцент #C62828. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!--
        Как читать этот файл.
        VectorDrawable — векторная картинка: Android рисует её по математическим командам,
        а не по пикселям, поэтому она остаётся чёткой на любом экране и в любом размере.

        width / height — размер иконки на экране (48dp).
        viewportWidth / viewportHeight — внутренняя сетка координат: 48 × 48 условных единиц.
        В них записан весь рисунок, а на экран он масштабируется целиком.
        pathData — команды контура: M — поставить перо в точку, L — линия к точке,
        C и Q — кривые, Z — замкнуть контур.
        fillColor — заливка внутри контура; запись #AARRGGBB: первые две цифры — прозрачность
        (00 — прозрачно, FF — плотно), остальные шесть — цвет. #00000000 значит «без заливки».
        strokeColor — цвет обводки, strokeWidth — её толщина в единицах viewport,
        strokeLineCap / strokeLineJoin — форма концов и стыков.
        group — контейнер: rotation поворачивает фигуры на угол в градусах вокруг точки
        pivotX / pivotY, при этом их pathData не меняются.

        Ниже — бокал-призрак с ореолом: по одной детали на каждый path.
    -->

    <!-- ореол: короткие штрихи по кругу -->
    <group>
        <!-- штрих ореола сверху -->
        <path android:pathData="M24,3 L24,6" android:strokeColor="#C62828" android:strokeWidth="1.4" android:strokeLineCap="round" />
        <!-- штрих ореола снизу -->
        <path android:pathData="M24,42 L24,45" android:strokeColor="#C62828" android:strokeWidth="1.4" android:strokeLineCap="round" />
        <!-- штрих ореола слева -->
        <path android:pathData="M3,24 L6,24" android:strokeColor="#C62828" android:strokeWidth="1.4" android:strokeLineCap="round" />
        <!-- штрих ореола справа -->
        <path android:pathData="M42,24 L45,24" android:strokeColor="#C62828" android:strokeWidth="1.4" android:strokeLineCap="round" />
        <!-- диагональный штрих: левый верхний угол -->
        <path android:pathData="M9,9 L11,11" android:strokeColor="#C62828" android:strokeWidth="1.4" android:strokeLineCap="round" />
        <!-- диагональный штрих: правый нижний угол -->
        <path android:pathData="M37,37 L39,39" android:strokeColor="#C62828" android:strokeWidth="1.4" android:strokeLineCap="round" />
        <!-- диагональный штрих: левый нижний угол -->
        <path android:pathData="M9,39 L11,37" android:strokeColor="#C62828" android:strokeWidth="1.4" android:strokeLineCap="round" />
        <!-- диагональный штрих: правый верхний угол -->
        <path android:pathData="M37,11 L39,9" android:strokeColor="#C62828" android:strokeWidth="1.4" android:strokeLineCap="round" />
    </group>

    <!-- зеленоватая заливка -->
    <path
        android:pathData="M14,19 L34,19 L31,36.5 L17,36.5 Z"
        android:fillColor="#66A5D6A7" />

    <!-- корпус бокала: стенки-трапеция, только обводка -->
    <path
        android:pathData="M12,12 L36,12 L31.5,38 L16.5,38 Z"
        android:fillColor="#00000000"
        android:strokeColor="#263238"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <!-- глаза-крестики -->
    <path android:pathData="M17.5,21.5 L21,25" android:strokeColor="#263238" android:strokeWidth="1.8" android:strokeLineCap="round" />
    <!-- левый глаз: вторая перекладина крестика -->
    <path android:pathData="M21,21.5 L17.5,25" android:strokeColor="#263238" android:strokeWidth="1.8" android:strokeLineCap="round" />
    <!-- правый глаз: первая перекладина крестика -->
    <path android:pathData="M27,21.5 L30.5,25" android:strokeColor="#263238" android:strokeWidth="1.8" android:strokeLineCap="round" />
    <!-- правый глаз: вторая перекладина крестика -->
    <path android:pathData="M30.5,21.5 L27,25" android:strokeColor="#263238" android:strokeWidth="1.8" android:strokeLineCap="round" />

    <!-- рот зигзагом -->
    <path
        android:pathData="M19,30 L21,28.3 L23,30 L25,28.3 L27,30 L29,28.3"
        android:fillColor="#00000000"
        android:strokeColor="#263238"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
