<?xml version="1.0" encoding="utf-8"?>
<!-- Степень 3: бокал-весельчак. Глаза-спирали, широкий рот, румянец, пузырьки. Акцент #FBC02D. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!--
        Как читать этот файл.
        VectorDrawable — векторная картинка: Android рисует её по математическим командам,
        а не по пикселям, поэтому она остаётся чёткой на любом экране и в любом размере.

        width / height — размер иконки на экране (48dp).
        viewportWidth / viewportHeight — внутренняя сетка координат: 48 × 48 условных единиц.
        В них записан весь рисунок, а на экран он масштабируется целиком.
        pathData — команды контура: M — поставить перо в точку, L — линия к точке,
        C и Q — кривые, Z — замкнуть контур.
        fillColor — заливка внутри контура; запись #AARRGGBB: первые две цифры — прозрачность
        (00 — прозрачно, FF — плотно), остальные шесть — цвет. #00000000 значит «без заливки».
        strokeColor — цвет обводки, strokeWidth — её толщина в единицах viewport,
        strokeLineCap / strokeLineJoin — форма концов и стыков.
        group — контейнер: rotation поворачивает фигуры на угол в градусах вокруг точки
        pivotX / pivotY, при этом их pathData не меняются.

        Ниже — бокал-весельчак: по одной детали на каждый path.
    -->

    <!-- жидкость: напиток внутри бокала, полупрозрачная жёлтая заливка -->
    <path
        android:pathData="M14,19 L34,19 L31,36.5 L17,36.5 Z"
        android:fillColor="#40FBC02D" />

    <!-- корпус бокала: трапеция-стенки, заливка прозрачная, видна только обводка -->
    <path
        android:pathData="M12,12 L36,12 L31.5,38 L16.5,38 Z"
        android:fillColor="#00000000"
        android:strokeColor="#263238"
        android:strokeWidth="1.8"
        android:strokeLineJoin="round"
        android:strokeLineCap="round" />

    <!-- румянец -->
    <path
        android:pathData="M17,29 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0"
        android:fillColor="#66EF6C00" />
    <!-- второй румянец: такое же пятно справа -->
    <path
        android:pathData="M31,29 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0"
        android:fillColor="#66EF6C00" />

    <!-- левый глаз-спираль -->
    <path
        android:pathData="M20,25.2 C19.2,24.4 19.2,23.2 20.2,22.8 C21.3,22.4 22.3,23.3 22,24.3 C21.7,25.3 20.4,25.4 19.8,24.6"
        android:fillColor="#00000000"
        android:strokeColor="#263238"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />

    <!-- правый глаз-спираль -->
    <path
        android:pathData="M28.5,25.2 C27.7,24.4 27.7,23.2 28.7,22.8 C29.8,22.4 30.8,23.3 30.5,24.3 C30.2,25.3 28.9,25.4 28.3,24.6"
        android:fillColor="#00000000"
        android:strokeColor="#263238"
        android:strokeWidth="1.5"
        android:strokeLineCap="round" />

    <!-- широкий рот -->
    <path
        android:pathData="M19,29 Q24,34.5 29,29 Z"
        android:fillColor="#263238" />

    <!-- пузырьки -->
    <path
        android:pathData="M24,9 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0"
        android:fillColor="#00000000"
        android:strokeColor="#FBC02D"
        android:strokeWidth="1.4" />
    <!-- пузырёк: средний, справа над бокалом -->
    <path
        android:pathData="M30,7 m-1.3,0 a1.3,1.3 0 1,0 2.6,0 a1.3,1.3 0 1,0 -2.6,0"
        android:fillColor="#00000000"
        android:strokeColor="#FBC02D"
        android:strokeWidth="1.2" />
    <!-- пузырёк: левый, самый маленький -->
    <path
        android:pathData="M18,6.5 m-1.1,0 a1.1,1.1 0 1,0 2.2,0 a1.1,1.1 0 1,0 -2.2,0"
        android:fillColor="#00000000"
        android:strokeColor="#FBC02D"
        android:strokeWidth="1.2" />
</vector>
